{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halos.dev/schemas/unit.schema.json",
  "title": "Unit",
  "description": "A business unit or team in the org hierarchy (ADR-0018): delegated owners, a member selector and an overlay applied on top of the ring profile. Enforced security fields may only be tightened.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Document version.",
      "const": "halos.dev/v1"
    },
    "kind": {
      "type": "string",
      "description": "Document kind.",
      "const": "Unit"
    },
    "name": {
      "type": "string",
      "description": "Unique name within its kind.",
      "pattern": "^[a-z0-9][a-zA-Z0-9._-]*$"
    },
    "labels": {
      "type": "object",
      "description": "Free-form labels.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "description": "What the unit is."
    },
    "parent": {
      "type": "string",
      "description": "Enclosing unit; empty for a top-level unit."
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "description": "CODEOWNERS owners of the unit directory: @org/team, @user or an email.",
      "items": {
        "type": "string",
        "pattern": "^(@[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)?|[^@\\s]+@[^@\\s]+\\.[^@\\s]+)$"
      }
    },
    "members": {
      "type": "object",
      "description": "Selects the unit's users from its parent's (any listed group or user matches).",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IdP groups."
        },
        "users": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User ids."
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "description": "Profile settings the unit changes on top of the baseline. Lists in permissions.deny, mcp.denied and hooks.items union; mcp.servers are added; other lists replace; env and telemetry.attributes merge per key.",
      "properties": {
        "models": {
          "type": "object",
          "description": "Model policy.",
          "properties": {
            "default": {
              "type": "string",
              "description": "Default model alias (a gateway.models key)."
            },
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Allowed model aliases."
            },
            "enforce": {
              "type": "boolean",
              "description": "Reject models outside allowed rather than only hiding them; default must then be in allowed."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "description": "Permission policy.",
          "properties": {
            "mode": {
              "type": "string",
              "description": "Default permission mode.",
              "enum": [
                "default",
                "acceptEdits",
                "plan",
                "auto"
              ]
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Allow rules."
            },
            "deny": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Deny rules."
            },
            "ask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ask rules."
            },
            "disableBypass": {
              "type": "boolean",
              "description": "Disable the harness's bypass-permissions mode."
            },
            "sandbox": {
              "type": "string",
              "description": "Harness sandbox policy.",
              "enum": [
                "off",
                "workspace-write",
                "read-only"
              ]
            },
            "sandboxRequired": {
              "type": "boolean",
              "description": "Fail closed: the harness refuses to run (Claude: sandbox.failIfUnavailable) instead of running unsandboxed when its sandbox dependencies are missing."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "description": "MCP policy.",
          "properties": {
            "managedOnly": {
              "type": "boolean",
              "description": "Block every server not listed."
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "An allowed MCP server.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Server name."
                  },
                  "url": {
                    "type": "string",
                    "description": "https URL (exclusive with command).",
                    "format": "uri"
                  },
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "stdio command line (exclusive with url)."
                  },
                  "headers": {
                    "type": "object",
                    "description": "HTTP headers.",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "tools": {
                    "type": "object",
                    "description": "Narrows the server's tools (ADR-0029). deny wins over allow; empty allow = every tool.",
                    "properties": {
                      "allow": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                        },
                        "description": "Only these tools (where the harness supports an allowlist; else a manifest warning)."
                      },
                      "deny": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
                        },
                        "description": "Never these tools."
                      }
                    },
                    "additionalProperties": false
                  },
                  "auth": {
                    "type": "object",
                    "description": "How clients authorize to a remote server (ADR-0029).",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "none",
                          "oauth",
                          "enterprise",
                          "halos"
                        ],
                        "description": "none (default) | oauth (the server's authorization server) | enterprise (Enterprise-Managed Authorization: an ID-JAG from identity.issuer) | halos (halo-server mints audience-bound tokens)."
                      },
                      "issuer": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://",
                        "description": "Authorization server issuer (oauth, enterprise)."
                      },
                      "clientID": {
                        "type": "string",
                        "description": "Pre-registered OAuth client id (oauth, enterprise)."
                      },
                      "clientIDMetadataURL": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https://",
                        "description": "https URL of an org-hosted Client ID Metadata Document (oauth); the URL is the client id."
                      },
                      "scopes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^\\S+$"
                        },
                        "description": "Scopes to request (oauth, enterprise)."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "description": "Allowed MCP servers."
            },
            "denied": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Denied server names."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "hooks": {
          "type": "object",
          "description": "Hook policy.",
          "properties": {
            "managedOnly": {
              "type": "boolean",
              "description": "Only managed hooks may run."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "A managed hook.",
                "properties": {
                  "event": {
                    "type": "string",
                    "description": "Hook event.",
                    "enum": [
                      "PreToolUse",
                      "PostToolUse",
                      "SessionStart",
                      "Stop",
                      "UserPromptSubmit"
                    ]
                  },
                  "matcher": {
                    "type": "string",
                    "description": "Tool matcher."
                  },
                  "command": {
                    "type": "string",
                    "description": "Command to run."
                  }
                },
                "required": [
                  "event",
                  "command"
                ],
                "additionalProperties": false
              },
              "description": "Managed hooks."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "telemetry": {
          "type": "object",
          "description": "Telemetry policy.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Emit OTEL telemetry. Must be true for profiles used by rings."
            },
            "otlpEndpoint": {
              "type": "string",
              "description": "OTLP endpoint URL."
            },
            "protocol": {
              "type": "string",
              "description": "OTLP protocol.",
              "enum": [
                "grpc",
                "http/protobuf"
              ]
            },
            "logPrompts": {
              "type": "boolean",
              "description": "Include prompt text in telemetry."
            },
            "attributes": {
              "type": "object",
              "description": "Extra resource attributes.",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "egress": {
          "type": "object",
          "description": "Network egress for the agent's shell and fetch tools (ADR-0032). A deny rule wins over an allow rule; unmatched hosts take the default. Rendered natively per harness; what a harness cannot hold is a release warning.",
          "properties": {
            "allowedDomains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "description": "Allowlist: exact hosts or *.domain (subdomains only, not the apex). Must allow the gateway host. Replaces the parent's list."
            },
            "default": {
              "type": "string",
              "enum": [
                "allow",
                "deny"
              ],
              "description": "For hosts no rule matches. Unset: deny when allowedDomains or presets allow anything, else allow. allow with an allowlist is an error."
            },
            "deniedDomains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "description": "Always denied, even when an allow rule matches. Unions down an extends chain and across units."
            },
            "presets": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "package-registries",
                  "vcs",
                  "model-providers"
                ]
              },
              "description": "Named domain sets added to the allowlist (see the egress and sandbox guide for each set's hosts)."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "sandbox": {
          "type": "object",
          "description": "Agent sandbox (ADR-0032): mode, extra writable roots and paths the agent may never read or write.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "workspace-write",
                "read-only"
              ],
              "description": "Same setting as permissions.sandbox (set either; both must agree). off is an error while egress or sandbox paths are set."
            },
            "writableRoots": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(/|~/)"
              },
              "description": "Absolute or ~/ directories writable beyond the workspace (no globs, not / or ~, not over a protected path). Replaces the parent's list; a unit adding one is a loosening."
            },
            "protectedPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Never read or written by the agent: absolute, ~/ or workspace-relative globs such as .env*. Unions down an extends chain and across units."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "instructions": {
          "type": "string",
          "description": "Appended to the inherited instructions (managed CLAUDE.md / AGENTS.md / GEMINI.md)."
        },
        "env": {
          "type": "object",
          "description": "Extra environment; may add keys, never change an inherited one.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "agents": {
          "type": "object",
          "description": "Bounds delegated agents for this profile's members (ADR-0024). A unit overlay may only lower maxDepth and narrow remote.",
          "properties": {
            "maxDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "Lowers agents.maxDepth for these members."
            },
            "remote": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "agents.remote names these members may call; empty = every entry whose rings or units admit them."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "owners",
    "members"
  ],
  "additionalProperties": false
}
