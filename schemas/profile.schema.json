{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halos.dev/schemas/profile.schema.json",
  "title": "Profile",
  "description": "Desired harness behaviour, independent of any one CLI. Supports inheritance via extends.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Document version.",
      "const": "halos.dev/v1"
    },
    "kind": {
      "type": "string",
      "description": "Document kind.",
      "const": "Profile"
    },
    "name": {
      "type": "string",
      "description": "Unique name within its kind.",
      "pattern": "^[a-z0-9][a-zA-Z0-9._-]*$"
    },
    "labels": {
      "type": "object",
      "description": "Free-form labels.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extends": {
      "type": "string",
      "description": "Parent profile. Scalars: child wins; lists: child replaces; maps: merged."
    },
    "harnesses": {
      "type": "object",
      "description": "Enabled harnesses keyed by adapter name (claude-code, codex, gemini-cli, copilot-cli, cursor-agent, opencode).",
      "additionalProperties": {
        "type": "object",
        "description": "Harness settings.",
        "properties": {
          "version": {
            "type": "string",
            "description": "Exact CLI version pin such as 2.1.280 (no ranges or latest); required for profiles used by rings."
          },
          "model": {
            "type": "string",
            "description": "This harness's default model alias, replacing models.default for it (e.g. codex-default). Must be a gateway.models alias, and in models.allowed when enforce is set."
          },
          "overrides": {
            "type": "object",
            "description": "Raw harness-native keys merged last (escape hatch; guardrails still apply)."
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "description": "Model policy.",
      "properties": {
        "default": {
          "type": "string",
          "description": "Default model alias (a gateway.models key)."
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed model aliases."
        },
        "enforce": {
          "type": "boolean",
          "description": "Reject models outside allowed rather than only hiding them; default must then be in allowed."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "description": "Permission policy.",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Default permission mode.",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "auto"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allow rules."
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deny rules."
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ask rules."
        },
        "disableBypass": {
          "type": "boolean",
          "description": "Disable the harness's bypass-permissions mode."
        },
        "sandbox": {
          "type": "string",
          "description": "Harness sandbox policy.",
          "enum": [
            "off",
            "workspace-write",
            "read-only"
          ]
        },
        "sandboxRequired": {
          "type": "boolean",
          "description": "Fail closed: the harness refuses to run (Claude: sandbox.failIfUnavailable) instead of running unsandboxed when its sandbox dependencies are missing."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "description": "MCP policy.",
      "properties": {
        "managedOnly": {
          "type": "boolean",
          "description": "Block every server not listed."
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "An allowed MCP server.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Server name."
              },
              "url": {
                "type": "string",
                "description": "https URL (exclusive with command).",
                "format": "uri"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "stdio command line (exclusive with url)."
              },
              "headers": {
                "type": "object",
                "description": "HTTP headers.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Allowed MCP servers."
        },
        "denied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Denied server names."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "description": "Hook policy.",
      "properties": {
        "managedOnly": {
          "type": "boolean",
          "description": "Only managed hooks may run."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "A managed hook.",
            "properties": {
              "event": {
                "type": "string",
                "description": "Hook event.",
                "enum": [
                  "PreToolUse",
                  "PostToolUse",
                  "SessionStart",
                  "Stop",
                  "UserPromptSubmit"
                ]
              },
              "matcher": {
                "type": "string",
                "description": "Tool matcher."
              },
              "command": {
                "type": "string",
                "description": "Command to run."
              }
            },
            "required": [
              "event",
              "command"
            ],
            "additionalProperties": false
          },
          "description": "Managed hooks."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "description": "Telemetry policy.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Emit OTEL telemetry. Must be true for profiles used by rings."
        },
        "otlpEndpoint": {
          "type": "string",
          "description": "OTLP endpoint URL."
        },
        "protocol": {
          "type": "string",
          "description": "OTLP protocol.",
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        },
        "logPrompts": {
          "type": "boolean",
          "description": "Include prompt text in telemetry."
        },
        "attributes": {
          "type": "object",
          "description": "Extra resource attributes.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "egress": {
      "type": "object",
      "description": "Network egress for the agent's shell and fetch tools (ADR-0032). A deny rule wins over an allow rule; unmatched hosts take the default. Rendered natively per harness; what a harness cannot hold is a release warning.",
      "properties": {
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "description": "Allowlist: exact hosts or *.domain (subdomains only, not the apex). Must allow the gateway host. Replaces the parent's list."
        },
        "default": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "For hosts no rule matches. Unset: deny when allowedDomains or presets allow anything, else allow. allow with an allowlist is an error."
        },
        "deniedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)*[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "description": "Always denied, even when an allow rule matches. Unions down an extends chain and across units."
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "package-registries",
              "vcs",
              "model-providers"
            ]
          },
          "description": "Named domain sets added to the allowlist (see the egress and sandbox guide for each set's hosts)."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sandbox": {
      "type": "object",
      "description": "Agent sandbox (ADR-0032): mode, extra writable roots and paths the agent may never read or write.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "workspace-write",
            "read-only"
          ],
          "description": "Same setting as permissions.sandbox (set either; both must agree). off is an error while egress or sandbox paths are set."
        },
        "writableRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/|~/)"
          },
          "description": "Absolute or ~/ directories writable beyond the workspace (no globs, not / or ~, not over a protected path). Replaces the parent's list; a unit adding one is a loosening."
        },
        "protectedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Never read or written by the agent: absolute, ~/ or workspace-relative globs such as .env*. Unions down an extends chain and across units."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "Plugin, skill, subagent, output style and status line governance. Unset means unrestricted; each adapter renders what its harness can enforce and warns about the rest.",
      "properties": {
        "marketplaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketplace"
          },
          "description": "Allowlist of plugin marketplace sources (Claude Code strictKnownMarketplaces, Codex marketplaces.allowed_sources, Copilot strictKnownMarketplaces); empty means any. The vendor's own marketplace is blocked unless listed."
        },
        "blockedMarketplaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/marketplace"
          },
          "description": "Marketplace sources users may never use (Claude Code blockedMarketplaces). Unions down an extends chain."
        },
        "plugins": {
          "type": "object",
          "description": "Individual plugin pins, keyed PLUGIN@MARKETPLACE.",
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+$"
              },
              "description": "Plugins required on."
            },
            "blocked": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+$"
              },
              "description": "Plugins required off. Unions down an extends chain."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "skills": {
          "$ref": "#/$defs/extensionSet"
        },
        "subagents": {
          "$ref": "#/$defs/extensionSet"
        },
        "outputStyle": {
          "type": "string",
          "description": "Output style name (Claude Code outputStyle)."
        },
        "statusLine": {
          "type": "object",
          "description": "Managed status-line command (Claude Code statusLine).",
          "properties": {
            "command": {
              "type": "string",
              "description": "Command that renders the status line."
            },
            "padding": {
              "type": "integer",
              "minimum": 0,
              "description": "Horizontal padding in characters; requires command."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Supply-chain artifacts (halos.yaml supplyChain.artifacts names) this profile delivers (ADR-0028). Claude Code places skills, agents, commands and hooks in its managed directory; other adapters warn."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "login": {
      "type": "string",
      "description": "Restrict how users authenticate: subscription (claude.ai, ChatGPT or Google login) or api (API key or gateway credential). Unset means unrestricted.",
      "enum": [
        "subscription",
        "api"
      ]
    },
    "instructions": {
      "type": "string",
      "description": "Org-wide memory rendered as managed CLAUDE.md / AGENTS.md / GEMINI.md."
    },
    "env": {
      "type": "object",
      "description": "Extra environment applied to every harness.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "agents": {
      "type": "object",
      "description": "Bounds delegated agents for this profile's members (ADR-0024). A unit overlay may only lower maxDepth and narrow remote.",
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Lowers agents.maxDepth for these members."
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "agents.remote names these members may call; empty = every entry whose rings or units admit them."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "marketplace": {
      "type": "object",
      "description": "A plugin marketplace source.",
      "properties": {
        "source": {
          "type": "string",
          "description": "Source kind.",
          "enum": [
            "github",
            "git",
            "url",
            "hostPattern"
          ]
        },
        "repo": {
          "type": "string",
          "description": "OWNER/REPO (source github).",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "description": "Repository or marketplace.json URL (sources git and url).",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "description": "Branch or tag (sources github and git)."
        },
        "hostPattern": {
          "type": "string",
          "description": "Regular expression over marketplace hosts (source hostPattern)."
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "extensionSet": {
      "type": "object",
      "description": "Governance for a user-authored extension kind.",
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names that must not load. Unions down an extends chain."
        },
        "pluginOnly": {
          "type": "boolean",
          "description": "Allow only extensions delivered by plugins or managed settings; user and project sources are blocked (Claude Code strictPluginOnlyCustomization)."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
