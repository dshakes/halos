{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halos.dev/schemas/toggle.schema.json",
  "title": "Toggle",
  "description": "A feature toggle: one capability turned on for a targeted cohort and killable instantly without a new release.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Document version.",
      "const": "halos.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "description": "Document kind.",
      "const": "Toggle"
    },
    "name": {
      "type": "string",
      "description": "Unique name within its kind.",
      "pattern": "^[a-z0-9][a-zA-Z0-9._-]*$"
    },
    "labels": {
      "type": "object",
      "description": "Free-form labels.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "description": "What the toggle does."
    },
    "owner": {
      "type": "string",
      "description": "Team or person who answers for the toggle."
    },
    "expires": {
      "type": "string",
      "description": "Removal date (YYYY-MM-DD); past it, validate warns that the toggle is stale.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "default": {
      "type": "boolean",
      "description": "State when no rule matches."
    },
    "axis": {
      "type": "string",
      "description": "client: a settings fragment in the signed release. traffic: a model route switch at the gateway.",
      "enum": [
        "client",
        "traffic"
      ]
    },
    "rules": {
      "type": "array",
      "description": "Evaluated in order; the first match decides.",
      "items": {
        "type": "object",
        "description": "Matches when every condition it sets holds; the first matching rule decides.",
        "properties": {
          "name": {
            "type": "string"
          },
          "rings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Match subjects in any of these rings."
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Match subjects in any of these IdP groups."
          },
          "users": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Match these user ids."
          },
          "percent": {
            "type": "number",
            "description": "Percent (0-100) of matching subjects, hashed under the salt halos/toggles/<name>.",
            "minimum": 0,
            "maximum": 100
          },
          "effect": {
            "type": "string",
            "description": "State when the rule matches (default on).",
            "enum": [
              "on",
              "off"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "client": {
      "type": "object",
      "description": "Payload of a client-axis toggle.",
      "properties": {
        "harnesses": {
          "type": "object",
          "description": "Fragment per harness name.",
          "additionalProperties": {
            "type": "object",
            "description": "What the toggle adds to this harness's resolved profile when on. Goes through the profile guardrails (override allowlist, secrets, reserved env, no bypassPermissions).",
            "properties": {
              "mcpServers": {
                "type": "array",
                "description": "MCP servers to add: exactly one of url (https) or command.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "command": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "headers": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Use ${VAR} references, never literal credentials."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "hooks": {
                "type": "array",
                "description": "Hooks to add. Give them a matcher of their own.",
                "items": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "type": "string",
                      "enum": [
                        "PreToolUse",
                        "PostToolUse",
                        "SessionStart",
                        "Stop",
                        "UserPromptSubmit"
                      ]
                    },
                    "matcher": {
                      "type": "string"
                    },
                    "command": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "event",
                    "command"
                  ],
                  "additionalProperties": false
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables to add (no reserved renderer prefixes, no literal secrets)."
              },
              "overrides": {
                "type": "object",
                "description": "Harness-native keys, restricted to the same allowlist as profile overrides."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "harnesses"
      ],
      "additionalProperties": false
    },
    "traffic": {
      "type": "object",
      "description": "Payload of a traffic-axis toggle.",
      "properties": {
        "routes": {
          "type": "object",
          "description": "Gateway model alias -> route used while the toggle is on.",
          "additionalProperties": {
            "type": "object",
            "description": "A single upstream+model.",
            "properties": {
              "upstream": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "targets": {
                "type": "array",
                "description": "Ordered/weighted targets (mutually exclusive with upstream+model).",
                "items": {
                  "type": "object",
                  "properties": {
                    "upstream": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "weight": {
                      "type": "number"
                    },
                    "priority": {
                      "type": "integer"
                    },
                    "timeoutSeconds": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "upstream",
                    "model"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "routes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "owner",
    "axis"
  ],
  "additionalProperties": false
}
