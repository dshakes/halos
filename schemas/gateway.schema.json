{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halos.dev/schemas/gateway.schema.json",
  "title": "Gateway",
  "description": "How harness traffic reaches models: public URL, auth, model aliases and upstreams.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Document version.",
      "const": "halos.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "description": "Document kind.",
      "const": "Gateway"
    },
    "name": {
      "type": "string",
      "description": "Unique name within its kind.",
      "pattern": "^[a-z0-9][a-zA-Z0-9._-]*$"
    },
    "labels": {
      "type": "object",
      "description": "Free-form labels.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "baseURL": {
      "type": "string",
      "description": "What clients are pointed at (Kong's public listener).",
      "format": "uri"
    },
    "protocols": {
      "type": "object",
      "description": "Wire protocol per harness name.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "anthropic-messages",
          "bedrock-invoke",
          "openai-responses",
          "gemini"
        ]
      }
    },
    "auth": {
      "type": "object",
      "description": "How clients obtain a credential for the auth gateway.",
      "properties": {
        "helperCommand": {
          "type": "string",
          "description": "Command that prints a short-lived token (Claude apiKeyHelper, Codex env_key source, ...)."
        },
        "ttlSeconds": {
          "type": "integer",
          "description": "Token lifetime in seconds.",
          "minimum": 0
        },
        "identityHeader": {
          "type": "string",
          "description": "Header the auth gateway sets with the verified user id."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "description": "Stable alias (what clients request) to upstream target.",
      "additionalProperties": {
        "type": "object",
        "description": "Upstream target for a model alias.",
        "properties": {
          "upstream": {
            "type": "string",
            "description": "Name of an entry in gateway.upstreams."
          },
          "model": {
            "type": "string",
            "description": "Provider model id or Bedrock inference profile ARN."
          }
        },
        "required": [
          "upstream",
          "model"
        ],
        "additionalProperties": false
      }
    },
    "upstreams": {
      "type": "object",
      "description": "Named backends.",
      "additionalProperties": {
        "type": "object",
        "description": "A backend.",
        "properties": {
          "url": {
            "type": "string",
            "description": "Base URL of the backend.",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "description": "Backend type.",
            "enum": [
              "orchestrator",
              "anthropic",
              "bedrock",
              "openai",
              "gemini"
            ]
          },
          "region": {
            "type": "string",
            "description": "AWS SigV4 region for kind bedrock (default: parsed from a bedrock-runtime.<region>.amazonaws.com host).",
            "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$"
          }
        },
        "required": [
          "url",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "baseURL",
    "auth",
    "models",
    "upstreams"
  ],
  "additionalProperties": false
}
