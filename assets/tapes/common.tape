Set Shell "bash"
Set FontSize 15
Set Width 1500
Set Height 620
Set Padding 28
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set WindowBar Colorful
Set BorderRadius 10
Hide
Type "export PATH=$PWD/../../bin:$PATH PS1='\[\e[38;5;80m\]❯\[\e[0m\] ' && cd ../../examples/acme-corp && clear"
Enter
Show
