[
  {"name": "Entra ID queries the user by userName before creating it",
   "method": "GET", "path": "/scim/v2/Users?filter=userName+eq+%22jane.doe%40acme.example%22", "status": 200},
  {"name": "Entra ID creates the user (enterprise extension, roles and meta are accepted and ignored)",
   "method": "POST", "path": "/scim/v2/Users", "status": 201, "save": "user",
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User", "urn:ietf:params:scim:schemas:extension:enterprise:2.0:User"],
            "externalId": "0a21f0f2-8d2a-4f8e-bf98-7363c4aed4ef", "userName": "jane.doe@acme.example", "active": true,
            "emails": [{"primary": true, "type": "work", "value": "jane.doe@acme.example"}],
            "meta": {"resourceType": "User"},
            "name": {"formatted": "Jane Doe", "familyName": "Doe", "givenName": "Jane"},
            "roles": [],
            "urn:ietf:params:scim:schemas:extension:enterprise:2.0:User": {"employeeNumber": "701984", "department": "Platform"}}},
  {"name": "Entra ID updates a multi-valued and a sub-attribute (capitalised op names)",
   "method": "PATCH", "path": "/scim/v2/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Replace", "path": "emails[type eq \"work\"].value", "value": "jane.d@acme.example"},
                           {"op": "Replace", "path": "name.familyName", "value": "Doe-Smith"}]}},
  {"name": "Entra ID adds an enterprise extension attribute (ignored, audited)",
   "method": "PATCH", "path": "/scim/v2/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Add", "path": "urn:ietf:params:scim:schemas:extension:enterprise:2.0:User:employeeNumber", "value": "701985"},
                           {"op": "Add", "path": "title", "value": "Staff Engineer"}]}},
  {"name": "Entra ID creates the group",
   "method": "POST", "path": "/scim/v2/Groups", "status": 201, "save": "group",
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group", "http://schemas.microsoft.com/2006/11/ResourceManagement/ADSCIM/2.0/Group"],
            "externalId": "8aa1a0c0-c4c3-4bc0-b4a5-2ef676900159", "displayName": "ai-platform", "meta": {"resourceType": "Group"}}},
  {"name": "Entra ID queries the group by displayName without members",
   "method": "GET", "path": "/scim/v2/Groups?excludedAttributes=members&filter=displayName+eq+%22ai-platform%22", "status": 200},
  {"name": "Entra ID adds the member",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Add", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "Entra ID removes the member with a value list",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Remove", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "Entra ID adds the member back",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Add", "path": "members", "value": [{"$ref": null, "value": "{{user}}"}]}]}},
  {"name": "Entra ID replaces a non-member group attribute",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Replace", "path": "externalId", "value": "8aa1a0c0-0000-4bc0-b4a5-2ef676900159"}]}},
  {"name": "Entra ID disables the user with a string boolean",
   "method": "PATCH", "path": "/scim/v2/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "Replace", "path": "active", "value": "False"}]}}
]
