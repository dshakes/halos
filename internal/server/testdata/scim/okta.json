[
  {"name": "Okta tests the connection: list users with a filter that matches nobody",
   "method": "GET", "path": "/scim/v2/Users?filter=userName%20eq%20%22jane.doe%40acme.example%22&startIndex=1&count=100", "status": 200},
  {"name": "Okta creates the user (password is sent and must be ignored)",
   "method": "POST", "path": "/scim/v2/Users", "status": 201, "save": "user",
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "userName": "jane.doe@acme.example",
            "name": {"givenName": "Jane", "familyName": "Doe"},
            "emails": [{"primary": true, "value": "jane.doe@acme.example", "type": "work"}],
            "displayName": "Jane Doe", "locale": "en-US", "externalId": "00ujl29u0le5T6Aj10h7",
            "groups": [], "password": "1mz050nq", "active": true}},
  {"name": "Okta reads the user back",
   "method": "GET", "path": "/scim/v2/Users/{{user}}", "status": 200},
  {"name": "Okta creates a pushed group",
   "method": "POST", "path": "/scim/v2/Groups", "status": 201, "save": "group",
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:Group"], "displayName": "ai-platform-tmp", "members": []}},
  {"name": "Okta renames the group with a path-less replace (echoing the id)",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "replace", "value": {"id": "{{group}}", "displayName": "ai-platform"}}]}},
  {"name": "Okta adds the member with PATCH",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "add", "path": "members", "value": [{"value": "{{user}}", "display": "jane.doe@acme.example"}]}]}},
  {"name": "Okta updates the profile with PUT",
   "method": "PUT", "path": "/scim/v2/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"], "id": "{{user}}", "userName": "jane.doe@acme.example",
            "name": {"givenName": "Jane", "familyName": "Doe-Smith"},
            "emails": [{"primary": true, "value": "jane.doe@acme.example", "type": "work"}],
            "displayName": "Jane Doe-Smith", "externalId": "00ujl29u0le5T6Aj10h7", "active": true}},
  {"name": "Okta removes the member with a value filter",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "remove", "path": "members[value eq \"{{user}}\"]"}]}},
  {"name": "Okta adds the member back",
   "method": "PATCH", "path": "/scim/v2/Groups/{{group}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "add", "path": "members", "value": [{"value": "{{user}}"}]}]}},
  {"name": "Okta deactivates the user (path-less replace)",
   "method": "PATCH", "path": "/scim/v2/Users/{{user}}", "status": 200,
   "body": {"schemas": ["urn:ietf:params:scim:api:messages:2.0:PatchOp"],
            "Operations": [{"op": "replace", "value": {"active": false}}]}}
]
