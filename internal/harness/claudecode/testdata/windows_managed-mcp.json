{
  "mcpServers": {
    "docs": {
      "headers": {
        "X-Org": "acme"
      },
      "headersHelper": "halo mcp token --resource 'https://mcp.example.com/docs' --format headers",
      "type": "http",
      "url": "https://mcp.example.com/docs"
    },
    "lint": {
      "args": [
        "-y",
        "lint-mcp"
      ],
      "command": "npx"
    },
    "tickets": {
      "oauth": {
        "clientId": "halos-cli",
        "scopes": "tickets:read"
      },
      "type": "http",
      "url": "https://mcp.example.com/tickets"
    }
  }
}
