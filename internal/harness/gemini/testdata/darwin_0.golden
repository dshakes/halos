{
  "agents": {
    "overrides": {
      "Explore": {
        "enabled": false
      }
    }
  },
  "mcp": {
    "allowed": [
      "docs",
      "lint",
      "tickets"
    ],
    "excluded": [
      "filesystem"
    ]
  },
  "mcpServers": {
    "docs": {
      "excludeTools": [
        "delete_page"
      ],
      "headers": {
        "X-Org": "acme"
      },
      "httpUrl": "https://mcp.example.com/docs",
      "includeTools": [
        "search",
        "fetch"
      ]
    },
    "lint": {
      "args": [
        "-y",
        "lint-mcp"
      ],
      "command": "npx"
    },
    "tickets": {
      "httpUrl": "https://mcp.example.com/tickets",
      "oauth": {
        "clientId": "halos-cli",
        "enabled": true,
        "issuer": "https://auth.example.com",
        "scopes": [
          "tickets:read"
        ]
      }
    }
  },
  "model": {
    "name": "halo-sonnet"
  },
  "security": {
    "auth": {
      "enforcedType": "gemini-api-key"
    },
    "disableYoloMode": true
  },
  "skills": {
    "disabled": [
      "deploy"
    ]
  },
  "telemetry": {
    "enabled": true,
    "logPrompts": true,
    "otlpEndpoint": "https://otel.example.com:4317",
    "otlpProtocol": "grpc",
    "target": "local"
  }
}
