{
  "allowedMcpServers": [
    {
      "serverUrl": "https://mcp.example.com/docs"
    },
    {
      "serverCommand": [
        "npx",
        "-y",
        "lint-mcp"
      ]
    }
  ],
  "deniedMcpServers": [
    {
      "serverName": "filesystem"
    }
  ],
  "enabledPlugins": {
    "audit@acme-plugins": true,
    "risky@acme-plugins": false
  },
  "model": "halo-sonnet",
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowBypass": false,
    "enabled": true,
    "userPolicy": {
      "network": {
        "allowedHosts": [
          "example.com",
          "github.com"
        ]
      }
    }
  },
  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "acme/plugins",
      "ref": "v1"
    },
    {
      "source": "hostPattern",
      "hostPattern": "^git\\.example\\.com$"
    }
  ]
}
