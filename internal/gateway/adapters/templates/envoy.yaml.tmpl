# GENERATED by internal/gateway/adapters (go test ./internal/gateway/adapters -update).
# Envoy static bootstrap: everything on :10000 goes to halo-proxy.
static_resources:
  listeners:
    - name: llm
      address: {socket_address: {address: 0.0.0.0, port_value: 10000}}
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: llm
                stream_idle_timeout: {{.TimeoutSeconds}}s   # idle between chunks, not total stream length
                route_config:
                  name: llm
                  virtual_hosts:
                    - name: all
                      domains: ["*"]
                      routes:
                        - match: {prefix: "/"}
                          route:
                            cluster: halo_proxy
                            timeout: 0s                   # disable the 15s default route timeout (long streams)
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: halo_proxy
      type: STRICT_DNS
      connect_timeout: 5s
      load_assignment:
        cluster_name: halo_proxy
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address: {socket_address: {address: {{.Host}}, port_value: {{.Port}}}}
