---
// Starlight's site title plus a version badge. The site documents main; the
// badge links to the same docs tree at the latest release tag.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import { release, releaseDocsUrl } from '../data/release';
---

<Default {...Astro.props}><slot /></Default>
<a class="ver" href={releaseDocsUrl} title={`This site documents main. Docs as of ${release}.`}>{release}</a>

<style>
  .ver {
    display: inline-flex;
    align-items: center;
    align-self: center;
    height: 1.45rem;
    margin-inline-start: 0.6rem;
    padding: 0 0.5rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    line-height: 1;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .ver:hover { color: var(--sl-color-accent-high); border-color: var(--sl-color-accent); }
  @media (max-width: 30rem) { .ver { display: none; } }
</style>
