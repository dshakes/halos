{
  "uid": "halo-fleet",
  "title": "Halos: fleet and experiments",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "halos"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Sessions by ring",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, ring, sum(value) AS sessions FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.sessions' GROUP BY time, ring ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Fleet: sessions by release",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT ring, release, harness, uniqExact(unit_id) AS users, sum(value) AS sessions FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.sessions' GROUP BY ring, release, harness ORDER BY ring, release"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Cost by ring (USD)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, ring, sum(value) AS cost_usd FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.cost.usd' GROUP BY time, ring ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Tokens by harness",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, harness, sum(value) AS tokens FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.tokens' GROUP BY time, harness ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Guardrail: cost per user by variant ($experiment)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, variant, sum(value) / uniqExact(unit_id) AS cost_per_user FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.cost.usd' AND experiment = '${experiment}' GROUP BY time, variant ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Guardrail: edit accept rate by variant ($experiment)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(ts) AS time, variant, countIf(attrs['decision'] = 'accept') / count() AS accept_rate FROM halo.halo_metrics WHERE $__timeFilter(ts) AND metric = 'halo.edit.decision' AND experiment = '${experiment}' GROUP BY time, variant ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_CLICKHOUSE",
        "label": "ClickHouse",
        "type": "datasource",
        "query": "grafana-clickhouse-datasource"
      },
      {
        "name": "experiment",
        "label": "Experiment",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "${DS_CLICKHOUSE}"
        },
        "refresh": 2,
        "query": "SELECT DISTINCT experiment FROM halo.halo_metrics WHERE experiment != '' ORDER BY experiment",
        "includeAll": false
      }
    ]
  }
}