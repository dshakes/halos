        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(halo_proxy_upstream_ttfb_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
