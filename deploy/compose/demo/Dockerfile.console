# halo-server WITH the embedded web console (make demo). Dockerfile.svc builds
# without -tags webdist and serves only a placeholder page; release images get
# the console from goreleaser (-tags=webdist). Build context: repo root.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
# Not `COPY web/`: a host node_modules (other OS/arch natives) must not land here.
COPY web/index.html web/tsconfig.json web/vite.config.ts ./
COPY web/src ./src
RUN npm run build

FROM golang:1.25@sha256:699337d620559a59b4a2bb298ad59611e535d2ee755a34cf2d2a98f37578dc80 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN rm -rf web/dist # a stale host build must not mix with the fresh one
COPY --from=web /web/dist ./web/dist
RUN CGO_ENABLED=0 go build -tags webdist -o /out/app ./cmd/halo-server

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
# git + a gh stub: the demo's "Propose change" pushes a branch to a local policy remote.
RUN apk add --no-cache git
COPY deploy/compose/demo/gh-stub.sh /usr/local/bin/gh
COPY --from=build /out/app /usr/local/bin/app
ENTRYPOINT ["/usr/local/bin/app"]
