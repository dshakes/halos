# build context: repo root; --build-arg PKG=./cmd/halo-shadow
FROM golang:1.25 AS build
ARG PKG
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/app ${PKG}

FROM alpine:3.20
COPY --from=build /out/app /usr/local/bin/app
ENTRYPOINT ["/usr/local/bin/app"]
